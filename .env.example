# ---------------------------------------------------------------
# Copy this file to .env (or run `npm run setup`) and adjust values.
# The defaults below work out of the box with `docker compose up -d`.
# ---------------------------------------------------------------

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://cloudimage:cloudimage@localhost:5432/cloudimage"

# Authentication
# Generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI API (optional)
# Leave empty to use the built-in local mock assistant.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# AWS S3 (optional)
# Leave empty to use local storage behaviour.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# Application
NODE_ENV="development"
